{
  // Simulation engine: pure TypeScript. No DOM/WebWorker lib, so any use of
  // window, document, navigator, IndexedDB or timers fails to type-check.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/engine", "src/contracts"]
}
