{
  // React UI. May import contracts and engine (pure) but never persistence/worker.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/react", "vite-plugin-pwa/info"]
  },
  "include": ["src/app", "src/contracts", "src/engine"]
}
